FROM node:22-alpine

# isolated-vm needs build tools to compile its native addon and libstdc++ at runtime
RUN apk add --no-cache python3 make g++ libstdc++

WORKDIR /app

COPY cmd/language-server-js/package*.json ./
RUN npm ci --omit=dev

# Copy source files explicitly — avoids overwriting the Linux-compiled node_modules
# with any host-built (macOS) node_modules from the source tree
COPY cmd/language-server-js/*.js ./
COPY pkg/api/proto ./proto

EXPOSE 50052

CMD ["node", "main.js"]
